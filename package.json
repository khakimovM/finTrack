{
  "name": "fintrack",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.13.0",
  "engines": { "node": ">=20.11.0" },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:api": "npm run dev --workspace=api",
    "dev:web": "npm run dev --workspace=web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "db:up": "docker compose up -d postgres redis",
    "db:down": "docker compose down",
    "db:migrate": "npm --workspace=api exec prisma migrate dev",
    "db:deploy": "npm --workspace=api exec prisma migrate deploy",
    "db:generate": "npm --workspace=api exec prisma generate",
    "db:studio": "npm --workspace=api exec prisma studio",
    "db:seed": "npm --workspace=api exec tsx prisma/seed.ts",
    "format": "prettier --write \"**/*.{ts,tsx,json,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": ["eslint --fix", "prettier --write"],
    "*.{json,md}": ["prettier --write"]
  },
  "overrides": {
    "fastify": "4.28.1"
  }
}
