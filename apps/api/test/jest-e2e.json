{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testRegex": ".*\\.e2e-spec\\.ts$",
  "transform": { "^.+\\.ts$": "ts-jest" },
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/helpers/test-env.ts"],
  "globalSetup": "<rootDir>/helpers/global-setup.ts",
  "testTimeout": 60000
}
