# ==== Umumiy ====
NODE_ENV=development

# ==== Backend (apps/api) ====
PORT=5000
API_PREFIX=api
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5432/fintrack?schema=public"
REDIS_URL="redis://localhost:6379"

# Kamida 32 belgi. Ishlab chiqarishda: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min_32
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d
BCRYPT_ROUNDS=12

CLIENT_URL=http://localhost:5173
COOKIE_DOMAIN=localhost
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# ==== Frontend (apps/web) ====
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=FinTrack

# ==== Ixtiyoriy ====
GITHUB_TOKEN=
