# ==== Umumiy ====
NODE_ENV=development

# ==== Backend (apps/api) ====
PORT=5000
API_PREFIX=api
DATABASE_URL="postgresql://fintrack:fintrack@localhost:5434/fintrack?schema=public"
REDIS_URL="redis://localhost:6380"

# Kamida 32 belgi. Ishlab chiqarishda: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_to_a_long_random_string_min_32
JWT_REFRESH_SECRET=change_me_to_another_long_random_string_32
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

CLIENT_URL=http://localhost:5173
# Bo'sh qoldiring (host-only cookie). Faqat umumiy domen ostida subdomenlar ishlatilsa kerak.
COOKIE_DOMAIN=
# THROTTLE_TTL soniyada (API ichida millisekundga aylantiriladi)
THROTTLE_TTL=60
THROTTLE_LIMIT=100
# API oldidagi reverse-proxy hoplari soni: Railway = 1, Vercel rewrite + Railway = 2
TRUST_PROXY=1
# Swagger /api/docs: bo'sh qoldirilsa dev'da yoqiq, production'da o'chiq
SWAGGER_ENABLED=
# "Bugun" shu vaqt zonasida hisoblanadi (foydalanuvchi zonasi bo'lmasa)
APP_TIMEZONE=Asia/Tashkent
LOG_LEVEL=

# ==== Telegram (kirish + bot) ====
# BotFather'dan olingan token. Bo'sh bo'lsa bot va Telegram orqali kirish o'chiq (lokal dev).
TELEGRAM_BOT_TOKEN=
# Bot username, @ belgisisiz (masalan: fintrack_uz_bot)
TELEGRAM_BOT_USERNAME=
# Production: https://<api-domen>/api/v1/telegram/webhook. Bo'sh bo'lsa long polling ishlaydi.
TELEGRAM_WEBHOOK_URL=
# Webhook sirli tokeni: 32-256 belgi [A-Za-z0-9_-]. openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Ixtiyoriy: boshqa Bot API server manzili
TELEGRAM_API_ROOT=
# Bir martalik kirish kodlarini imzolash kaliti (production'da majburiy). openssl rand -base64 48
OTP_SECRET=
# Web ilova manzili (Mini App va bot havolalari uchun). Bo'sh bo'lsa CLIENT_URL.
WEB_APP_URL=
# Seed: demo foydalanuvchini o'z Telegram ID'ingizga bog'lash uchun (ixtiyoriy)
DEMO_TELEGRAM_ID=

# ==== Ovozli yordamchi (ixtiyoriy; kalit bo'lmasa ovozli xabarlar o'chiq) ====
# Gemini: ovoz -> matn -> yozuvlar, bitta so'rovda. Tekin kalit: https://aistudio.google.com
# Diqqat: tekin tarifda Google so'rovlarni o'z mahsulotlarini yaxshilash uchun ishlatishi mumkin.
GEMINI_API_KEY=
# Navbat bilan sinaladigan modellar (har birining tekin limiti alohida). Bo'sh = standart zanjir:
# gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.6-flash
GEMINI_MODELS=
# Groq Whisper: Gemini limiti tugaganda zaxira STT. Tekin kalit: https://console.groq.com
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3
# Ixtiyoriy, pullik: murakkab matnlarni ajratish uchun Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# Ovozli xabar uzunligi (soniya) va har bir foydalanuvchi uchun kunlik limitlar
VOICE_MAX_SECONDS=60
VOICE_DAILY_LIMIT=30
AI_TEXT_DAILY_LIMIT=50

# ==== Frontend (apps/web) ====
VITE_API_URL=http://localhost:5000/api/v1
VITE_APP_NAME=FinTrack

# ==== Ixtiyoriy ====
GITHUB_TOKEN=
